# tayga@pp01
.:6453 {
    bind 127.0.64.1
    multisocket 1
    dns64 {
        # Clients are routed to nyanshiba/nat64-on-link for each stateful connection.
        prefix 64:ff9b:1:1::/96
        translate_all
        allow_ipv4
    }
    forward . 127.0.6.1:1053
}

