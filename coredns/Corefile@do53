    bind 208.67.222.2
    bind 208.67.222.123
    bind 208.67.222.220 # Do53 only
    bind 208.67.222.222
    bind 204.194.232.200
    bind 204.194.234.200
    bind 223.5.5.5
    bind 223.6.6.6
