(view_exclude_probe) {
    view exclude_probe {
        expr client_ip() != '10.0.1.6' #&& client_ip() != '10.0.0.2'
    }
}
(view_include_probe) {
    view include_probe {
        expr client_ip() == '10.0.1.6'
    }
}
(nodata_a) {
    # this disables IPv4 fallback as defined in RFC 8305.
    rewrite continue type A NULL
}
(nodata_https) {
    # disabling RFC 9460 Sec.7.3 and 4.2 to enforce DNS64.
    rewrite continue type HTTPS NULL
}
pool.ntp.org. {
    import bind_dns64
    import bind_ipv6ss
    import bind_ipv4
    import view_exclude_probe
    file /usr/local/etc/coredns/zone/home.arpa home.arpa.
    file /usr/local/etc/coredns/zone/flets flets.
    forward www.pool.ntp.org. 127.0.6.1:1053
    rewrite stop name regex .*.datadog.pool.ntp.org. ntp.home.arpa. answer auto # off-link
    rewrite stop name regex www.pool.ntp.org. www.pool.ntp.org. answer auto # on-link
    rewrite stop name regex .* ntp.home.arpa. answer auto # on-link
}
