(bind_dns64) {
    multisocket 4
    rewrite ttl suffix . 30-
}
(bind_dns64p) {
    multisocket 4
    rewrite ttl suffix . 30-
}
(bind_ipv6) {
    multisocket 4
    rewrite ttl suffix . 30-
}
(bind_ipv4) {
    bind 10.0.8.53
    multisocket 4
    rewrite ttl suffix . 30-
    view sinkhole {
        expr client_ip() != '10.0.1.6' #&& client_ip() != '10.0.0.2'
    }
}
(bind_private) {
    bind eth0
    multisocket 4
    rewrite ttl suffix . 30-
    view sinkhole {
        expr client_ip() != '10.0.1.6' #&& client_ip() != '10.0.0.2'
    }
}
(nodata_a) {
    template IN A {
        authority "{{ .Name }} 33 IN SOA draft-hazeyama-sunset4-dns-a-filter-00.{{ .Zone }} hostmaster.{{ .Zone }} 1 60 1200 604800 60"
    }
}
pool.ntp.org.:53 {
    import bind_private
    template ANY ANY {
      answer  "{{ .Name }} 123 IN CNAME ntp.home.arpa."
        authority "{{ .Name }} 123 IN SOA rfc8633.{{ .Zone }} hostmaster.{{ .Zone }} 1 60 1200 604800 60"
    }
    forward . 127.0.6.1:1053
}
html-load.com.:53 {
    import bind_dns64
    loadbalance round_robin
    file /usr/local/etc/coredns/zone/html-load.com html-load.com. {
        fallthrough
    }
    forward . 127.0.255.0:1153 {
        except fb.html-load.com.
    }
    forward . 127.0.6.1:1053
}
html-load.com.:53 {
    import bind_ipv4
    forward . 127.0.255.0:1153 {
        except fb.html-load.com.
    }
    forward . 127.0.6.1:1053
}

# global local-zone
5ch.net.:53 2ch.net.:53 {
    import bind_private
    template IN HTTPS {
      match "(\w+)\.[25]ch\.net\.$"  
      answer  "{{ index .Match 1 }}.{{ .Zone }} 900 IN HTTPS 0 {{ index .Match 1 }}.5ch.io."
        authority "{{ .Name }} 900 IN SOA rfc9460.{{ .Zone }} hostmaster.{{ .Zone }} 1 60 1200 604800 60"
    }
    template ANY ANY {
        authority "{{ .Name }} 900 {{ .Class }} SOA rfc9460.{{ .Zone }} hostmaster.{{ .Zone }} 1 60 1200 604800 60"
    }
}
com.:53 {
    import bind_ipv6
    loadbalance round_robin
    file /usr/local/etc/coredns/zone/twitter.com twitter.com. {
        fallthrough
    }
    file /usr/local/etc/coredns/zone/x.com x.com. {
        fallthrough
    }
    file /usr/local/etc/coredns/zone/twimg.com twimg.com. {
        fallthrough
    }
    file /usr/local/etc/coredns/zone/nyanshiba.com nyanshiba.com. {
        fallthrough
    }
    file /usr/local/etc/coredns/zone/com com. {
        fallthrough
    }
    forward . 127.0.6.1:1053
}

