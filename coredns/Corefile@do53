## probe (DHCPv4)
. {
    import bind_ipv4
    import view_include_probe
    multisocket 1
    rewrite continue ttl suffix . 30-
    forward . 127.0.6.2:1053 # bypass sinkhole
}
## server (DHCPv4) IN A
. {
    import bind_ipv4
    import bind_ipv6ss
    multisocket 1
    rewrite continue ttl suffix . 30-
    view qtypefilter {
        expr type() == 'A' && !(incidr(client_ip(), '10.0.0.0/22') || incidr(client_ip(), '10.0.4.0/24') || client_ip() == '10.0.8.64')
    }
    file /usr/local/etc/coredns/zone/home.arpa home.arpa.
    forward . 127.0.255.0:1153 {
        # whitelisted IPv4 single-stack services
        except discord.com.
        except github.com.
        except api.minecraftservices.com.
        except sessionserver.mojang.com.
        except dot.net.
        except ripe.net.
        except speedtest.net.
        except ghcr.io.
        except discord.gg.
        except ftp.riken.jp.
        except spamhaus.org.
        except spamhaus.org.cdn.cloudflare.net.
    }
    forward . 127.0.6.1:1053
}
## server IN AAAA/HTTPS or client (DHCPv4, IPCP)
. {
    import bind_ipv4
    import bind_ipv6ss
    multisocket 1
    rewrite continue ttl suffix . 30-
    minimal # disabling AS4717's RFC 9460 Sec.4.2 support
    file /usr/local/etc/coredns/zone/home.arpa home.arpa.
    file /usr/local/etc/coredns/zone/twitter.com twitter.com. {
        fallthrough
    }
    file /usr/local/etc/coredns/zone/x.com x.com. {
        fallthrough
    }
    file /usr/local/etc/coredns/zone/com com. {
        fallthrough
    }
    file /usr/local/etc/coredns/zone/jp jp. {
        fallthrough
    }
    forward . 127.0.6.1:1053
}
