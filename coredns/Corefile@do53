    bind 162.159.36.2
    bind 208.67.220.2
    bind 208.67.220.123
    bind 208.67.220.220
    bind 208.67.220.222
    bind 208.67.222.2
    bind 208.67.222.123
    bind 208.67.222.220
    bind 208.67.222.222
    bind 223.5.5.5
    bind 223.6.6.6
    multisocket 1
    rewrite continue ttl suffix . 30-
}
(acl_refused_server) {
    acl {
        allow type A net 10.0.0.12/32 # vpn
        block type A net 10.0.0.0/24
        allow type A net 10.0.2.12/32 # vpn
        allow type A net 10.0.2.35/32 # Intel Dual Band Wirelless-AC 7265 rev. D does not support IPv6 DNS
        block type A net 10.0.2.0/24
        block type A net 10.0.5.0/24
        block type A net 10.0.6.0/23
        block type A net 10.0.8.0/21
    }
}
(view_exclude_probe) {
    view exclude_probe {
        expr client_ip() != '10.0.1.6' #&& client_ip() != '10.0.0.2'
    }
}
(nodata_a) {
    # this disables IPv4 fallback as defined in RFC 8305.
    rewrite continue type A SOA
}
(nodata_https) {
    # disabling RFC 9460 Sec.7.3 and 4.2 to enforce DNS64.
    rewrite continue type HTTPS SOA
}
pool.ntp.org.:53 {
    import bind_ipv6ss
    import bind_private
    import view_exclude_probe
    forward . 127.0.0.1:53
    rewrite stop name regex .* ntp.internal. answer auto
}
html-load.com.:53 {
    import bind_dns64
    loadbalance round_robin
    file /usr/local/etc/coredns/zone/html-load.com html-load.com. {
        fallthrough fb.html-load.com.
    }
    forward . 127.0.6.1:1053
}
html-load.com.:53 {
    import bind_ipv4
    import view_exclude_probe
    forward . 127.0.255.1:1153 {
        except fb.html-load.com.
    }
    forward . 127.0.6.1:1053
}

# global local-zone
5ch.net.:53 2ch.net.:53 {
    import bind_private
    import view_exclude_probe
    template IN HTTPS {
      match "(\w+)\.[25]ch\.net\.$"  
      answer  "{{ index .Match 1 }}.{{ .Zone }} 900 IN HTTPS 0 {{ index .Match 1 }}.5ch.io."
        authority "{{ .Name }} 900 IN SOA rfc9460.{{ .Zone }} hostmaster.{{ .Zone }} 1 60 1200 604800 60"
    }
    template ANY ANY {
        authority "{{ .Name }} 900 {{ .Class }} SOA rfc9460.{{ .Zone }} hostmaster.{{ .Zone }} 1 60 1200 604800 60"
    }
}

