twitter.com.:53 x.com.:53 t.co.:53 proxsee-cf.pscp.tv.:53 cdn.cloudflare.net.:53 {
    import bind_dns64p
    import nodata_https
    import nodata_a # force IPv6 to reduce ads
    loadbalance round_robin
    file /usr/local/etc/coredns/zone/twitter.com twitter.com. {
        fallthrough
    }
    file /usr/local/etc/coredns/zone/x.com x.com. {
        fallthrough
    }
    forward . 127.0.64.35:6453 {
        except grok.x.com. # envoy's rate-limiting are too strict
        except wr.x.com. # cname scrubbing from devices
        except realm-a.x.com. # com.x.xchat AWS
        except realm-b.x.com.
    }
    forward . 127.0.64.1:6453 127.0.64.4:6453 # bypass WARP Connector's CGNAT
    rewrite continue cname exact dynamic.x.map.fastly.net. dynamic.x.com.cdn.cloudflare.net. # DNS64 synthesis is performed in cdn.cloudflare.net.:53, not x.com.:53.
}
twimg.com.:53 {
    import bind_dns64p
    import nodata_https
    import nodata_a
    loadbalance round_robin
    file /usr/local/etc/coredns/zone/twimg.com twimg.com. { # use Fastly
        fallthrough
    }
    forward . 127.0.6.1:1053 {
        except abs.twimg.com.
        except abs-0.twimg.com.
        except abs-zero.twimg.com.
    }
    forward . 127.0.64.35:6453 # force warp
}

