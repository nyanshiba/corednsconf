(bind_upstream) {
    bind 127.0.6.1
    multisocket 1
    cache {
        serve_stale 24h immediate
    }
    loadbalance round_robin
    #minimal # affects AS4717's RFC 9460 Sec.4.2 support
    log . {
        class error
    }
    bufsize 1426 # 1454-20-8
}
