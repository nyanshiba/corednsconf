$ORIGIN push-apple.com.akadns.net.
$TTL 10800

@   IN  SOA dns.internal. admin.internal. (
        2026040701 ; Serial (YYYYMMDDnn)
        3600       ; Refresh (1 hour)
        900        ; Retry   (15 minutes)
        1209600    ; Expire  (14 days)
        300        ; Minimum (5 minutes)
)

@                       10800  IN  NS    dns.internal.

