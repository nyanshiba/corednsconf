(bind_doh) {
    multisocket 1
    loadbalance round_robin
    rewrite continue ttl suffix . 30-
    tls /etc/coredns/tls/fullchain.pem /etc/coredns/tls/privkey.pem
}

# bypass DNS sinkhole
https://.:853 {
    import bind_doh
    cache {
        serve_stale 24h immediate
    }
    forward . 127.0.6.2:1053
}
# breaking TLS verification to prevent DoH tunneling using iPAddress SANs
https://.:443 {
    bind 1.0.0.1 # DNS:one.one.one.one
    bind 1.1.1.1
    bind 8.8.4.4 # DNS:dns.google
    bind 8.8.8.8
