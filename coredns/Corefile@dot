(bind_dot) {
    multisocket 1
    rewrite continue ttl suffix . 120-
    tls /etc/coredns/tls/fullchain.pem /etc/coredns/tls/privkey.pem
    loadbalance round_robin
}
(nodata_a) {
    # this disables IPv4 fallback as defined in RFC 8305.
    rewrite continue type A NULL
}
(nodata_https) {
    # disabling RFC 9460 Sec.7.3
    rewrite continue type HTTPS NULL
}

# global local-zone
tls://html-load.com.:853 {
    import bind_dot
    forward . 127.0.255.1:1153 {
        except fb.html-load.com.
        except fb.stg.html-load.com.
    }
    forward . 127.0.6.1:1053
}
tls://discord.com.:853 tls://cdn.cloudflare.net.:853 {
    import bind_dot
    import nodata_https
    import nodata_a
    forward . 127.0.64.35:2653
}

# other
tls://.:853 {
    import bind_dot
    file /usr/local/etc/coredns/zone/twitter.com twitter.com. {
        fallthrough
    }
    file /usr/local/etc/coredns/zone/x.com x.com. {
        fallthrough
    }
    file /usr/local/etc/coredns/zone/twimg.com twimg.com. {
        fallthrough
    }
    file /usr/local/etc/coredns/zone/net net. {
        fallthrough
    }
    file /usr/local/etc/coredns/zone/io io. {
        fallthrough
    }
    file /usr/local/etc/coredns/zone/jp jp. {
        fallthrough
    }
    file /usr/local/etc/coredns/zone/tv tv. {
        fallthrough
    }
    forward . 127.0.6.1:1053 {
        except googlevideo.com. # reduce giga ga tarinai
        except video.twimg.com.
        except app.jrepoint.jp. # offline mode
    }
    forward . 127.0.255.0:1153
    rewrite continue cname exact dynamic.x.com.cdn.cloudflare.net. dynamic.x.map.fastly.net.
    rewrite continue cname suffix cdn.cloudflare.net. cdn.cloudflare.net.
}
